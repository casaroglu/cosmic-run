 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Why did the Ottomans never take Vienna?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "They tried twice. The second time, in 1683, they came closest, and lost the most."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How big was the empire then?",
   "scene": "start",
   "date": "1683",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Bigger than ever in Europe: most of Hungary, and even Podolia in today's Ukraine."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The Grand Vizier, Kara Mustafa Pasha, wanted the prize Suleiman had missed.",
   "scene": "karamustafa",
   "date": "1683",
   "place": "Istanbul",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In July 1683, his army reached Vienna and surrounded it.",
   "scene": "march",
   "date": "14 July 1683",
   "place": "Vienna"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Were they outnumbered inside?",
   "scene": "numbers"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Badly. About sixteen thousand defenders, under Count Starhemberg, against a campaign army of around ninety thousand.",
   "say": "Badly. About sixteen thousand defenders, under Count Starhemberg, against a campaign army of around ninety thousand."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "For two months the Ottomans dug mines under the walls and blew holes in them.",
   "scene": "siegemap",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.48,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So who saved the city?",
   "scene": "sobieski",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.32,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A relief army led by King John the Third Sobieski of Poland, with German and Austrian troops."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "On the twelfth of September 1683, they came down from the Kahlenberg hill.",
   "scene": "geffels",
   "date": "12 September 1683",
   "place": "Kahlenberg",
   "move": {
    "from": [
     0.35,
     0.5,
     1.0
    ],
    "to": [
     0.6,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In the evening, Sobieski led his winged hussars in a huge cavalry charge, and the Ottoman army broke.",
   "scene": "casteels",
   "move": {
    "from": [
     0.5,
     0.55,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "What happened to Kara Mustafa?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He was executed in Belgrade that December, on the sultan's orders."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And the empire?",
   "scene": "end",
   "date": "1699",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A long war followed. In 1699, at Karlowitz, the Ottomans gave up Hungary, Podolia and the Morea. Their first great loss of land."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: the sultan who destroyed his own army. Like the video and follow History Sketches."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: 1826, the end of the Janissaries",
   "sub": "Follow History Sketches"
  }
 ]
