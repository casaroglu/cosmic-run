 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "What happened at Lepanto in 1571?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "One of the largest sea battles in history, with more than four hundred warships."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where is Lepanto?",
   "scene": "today",
   "date": "Today",
   "place": "Gulf of Patras"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In Greece, on the Gulf of Patras. Today the town is called Nafpaktos.",
   "say": "In Greece, on the Gulf of Patras. Today the town is called Nafpaktoss."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Why did the battle happen?",
   "scene": "start",
   "date": "1570",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1570, Sultan Selim the Second attacked Cyprus, which belonged to Venice."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He was Suleiman's son.",
   "scene": "selim2",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.32,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Cyprus's last fortress, Famagusta, surrendered in August 1571.",
   "scene": "famagusta",
   "date": "1571",
   "place": "Famagusta",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And Europe answered?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Pope Pius the Fifth brought Spain, Venice and others together in a Holy League."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Its fleet was commanded by Don John of Austria, half-brother of King Philip the Second of Spain.",
   "scene": "donjohn",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.35,
     1.0
    ],
    "to": [
     0.5,
     0.28,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "On the seventh of October 1571, the two fleets met at the mouth of the Gulf of Patras.",
   "scene": "battlemap",
   "date": "7 October 1571",
   "place": "Lepanto"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How big were they?",
   "scene": "numbers"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "About the same size. But the Holy League brought six galleasses: huge floating gun platforms that broke up the Ottoman line."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who won?",
   "scene": "letter",
   "move": {
    "from": [
     0.35,
     0.5,
     1.0
    ],
    "to": [
     0.65,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The Holy League. The Ottoman admiral, Ali Pasha, was killed, and about two hundred Ottoman galleys were sunk or captured."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Around fifteen thousand Christian galley slaves were set free."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "One young Spanish soldier lost the use of his left hand there. His name was Miguel de Cervantes.",
   "scene": "cervantes",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.32,
     1.3
    ]
   },
   "say": "One young Spanish soldier lost the use of his left hand there. His name was Migel de Servantes."
  },
  {
   "type": "narration",
