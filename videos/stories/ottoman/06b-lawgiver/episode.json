 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Why do Turks call Suleiman the Lawgiver?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Because he gathered the empire's laws into one code. In Turkish he is Kanuni.",
   "say": "Because he gathered the empire's laws into one code. In Turkish he is Kahnoonee."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How big was his empire by then?",
   "scene": "start",
   "date": "1530",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "By 1530 it reached from Hungary to Egypt, full of peoples with different languages and faiths."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "With the scholar Ebussuud, he brought the sultan's laws and Islamic law together, covering crime, taxes and land.",
   "scene": "law",
   "date": "",
   "say": "With the scholar Ebu-su-ood, he brought the sultan's laws and Islamic law together, covering crime, taxes and land."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His seal, the tughra, stood at the top of every order.",
   "scene": "tughra",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   },
   "say": "His seal, the toogra, stood at the top of every order."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And who was Hürrem?",
   "scene": "hurremmap",
   "date": "1510s",
   "place": "Ruthenia",
   "say": "And who was Hurrem?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A girl from today's Ukraine. Crimean Tatars captured her in a slave raid, and she was brought to the palace harem in Istanbul."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Suleiman freed her and married her, breaking Ottoman custom. She was the first to hold the title Haseki Sultan.",
   "scene": "hurrem",
   "date": "1534",
   "place": "Istanbul",
   "move": {
    "from": [
     0.5,
     0.45,
     1.0
    ],
    "to": [
     0.5,
     0.38,
     1.3
    ]
   },
   "say": "Suleiman freed her and married her, breaking Ottoman custom. She was the first to hold the title Hasekee Sultan."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did they really love each other?",
   "scene": "hurrem2",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.42,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Their letters survive. He wrote poems for her under the pen name Muhibbi, which means lover.",
   "say": "Their letters survive. He wrote poems for her under the pen name Moo-hibbee, which means lover."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "She built mosques, a hospital and soup kitchens, from Istanbul to Jerusalem."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And the great mosque in Istanbul?",
   "scene": "suleymaniye",
   "date": "1550–1557",
   "place": "Süleymaniye",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.42,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His chief architect, Sinan, built the Süleymaniye Mosque between 1550 and 1557. Suleiman and Hürrem are buried beside it.",
   "say": "His chief architect, Sinan, built the Suleymaniye Mosque between 1550 and 1557. Suleiman and Hurrem are buried beside it."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Was his reign all poems and buildings?",
   "scene": "lorck",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.35,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Not exactly. In 1553, he had his own son, Mustafa, executed for fear of a rebellion."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And how did his story end?",
   "scene": "end",
   "date": "1566",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1566, aged seventy-one, he died on campaign at Szigetvár in Hungary. He ruled for forty-six years, longer than any other sultan.",
   "say": "In 1566, aged seventy-one, he died on campaign at Sigetvar in Hungary. He ruled for forty-six years, longer than any other sultan."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: Barbarossa, the pirate who became the sultan's admiral. Like the video and follow History Sketches.",
   "scene": "rosier",
   "move": {
