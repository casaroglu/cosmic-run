 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Why do Australians remember a beach in Turkey?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Because on the twenty-fifth of April 1915, their soldiers landed there, at Gallipoli. Today that day is Anzac Day."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Why was there a war there?",
   "scene": "start",
   "date": "1914",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1914, the Ottomans joined the First World War on Germany's side. Britain and France wanted the straits to Istanbul, to reach their ally Russia."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So they attacked by sea?",
   "scene": "straitmap",
   "date": "18 March 1915",
   "place": "Dardanelles"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Right. On the eighteenth of March 1915, a great Allied fleet tried to force the Dardanelles."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "But days earlier, a small Ottoman ship, the Nusret, had quietly laid a new line of mines.",
   "scene": "nusret",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Three battleships sank, and the fleet turned back.",
   "scene": "irresistible",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And then the landings?",
   "scene": "landings",
   "date": "25 April 1915",
   "place": "Gallipoli"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Yes. British troops landed at Cape Helles, Australians and New Zealanders at what became Anzac Cove."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "They got ashore, but not much further.",
   "scene": "landing",
   "move": {
    "from": [
     0.35,
     0.5,
     1.0
    ],
