 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "How did a pirate become the sultan's admiral?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His name was Hızır. Europe called him Barbarossa: Redbeard.",
   "say": "His name was Hizzer. Europe called him Barbarossa: Redbeard."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where was he from?",
   "scene": "home",
   "date": "Today",
   "place": "Lesbos"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "From Lesbos, a Greek island off today's Turkish coast. He and his brother Oruç became corsairs in the western Mediterranean.",
   "say": "From Lesbos, a Greek island off today's Turkish coast. He and his brother Oruch became corsairs in the western Mediterranean."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1516 they took Algiers. Two years later Oruç was killed, and Hızır took his place.",
   "scene": "algiers",
   "date": "1516",
   "place": "Algiers",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.45,
     1.3
    ]
   },
   "say": "In 1516 they took Algiers. Two years later Oruch was killed, and Hizzer took his place."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "To hold out against Spain, he placed Algiers under the Ottoman sultan."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And the sultan made him admiral?",
   "scene": "barbarossa",
   "date": "1533",
   "place": "Istanbul",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.32,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Right. In 1533, Suleiman made him Kapudan Pasha, grand admiral of the Ottoman navy.",
   "say": "Right. In 1533, Suleiman made him Kapoodan Pasha, grand admiral of the Ottoman navy."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who were his enemies?",
   "scene": "start",
   "date": "1533",
   "place": "Mediterranean"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Spain, under Charles the Fifth, Venice, and the Pope. In 1538 they joined together in a Holy League."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Their fleet was led by the Genoese admiral Andrea Doria.",
   "scene": "doria",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.32,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In September 1538, the two fleets met off Preveza, in northwestern Greece.",
   "scene": "prevezamap",
   "date": "1538",
   "place": "Preveza"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who had more ships?",
   "scene": "numbers"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The Holy League, by far, with big sailing ships as well as galleys."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So how did Barbarossa win?",
   "scene": "preveza",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.6,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "When the wind dropped, Doria's sailing ships could barely move, and his allies did not trust each other. Doria pulled back."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Barbarossa did not lose a single ship."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "What did that change?",
   "scene": "end",
   "date": "1540",
   "place": "Mediterranean"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "For about thirty years, the Ottomans ruled the Mediterranean. In 1540, Venice made peace and gave up its last ports in the Morea and islands in the Aegean."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Barbarossa died in Istanbul in 1546. His tomb still stands by the Bosphorus.",
   "scene": "nigari",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.35,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: Lepanto, the battle that broke this fleet. Like the video and follow History Sketches."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: Lepanto, 1571",
   "sub": "Follow History Sketches"
  }
 ]
}