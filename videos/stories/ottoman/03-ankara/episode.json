 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Was an Ottoman sultan ever taken prisoner?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Just once. It happened here, near Ankara, today the capital of Türkiye."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who was the sultan?",
   "scene": "today",
   "date": "Today",
   "place": "Ankara"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Bayezid the First. His soldiers called him Yildirim: the Thunderbolt.",
   "scene": "thunder",
   "date": "1389–1402",
   "place": "Ottoman Empire",
   "say": "Bayezid the First. His soldiers called him Yuldurum: the Thunderbolt."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1396 he crushed a crusader army at Nicopolis, on the Danube.",
   "scene": "nicopolis",
   "date": "1396",
   "place": "Nicopolis",
   "move": {
    "from": [
     0.5,
     0.3,
     1.0
    ],
    "to": [
     0.5,
     0.6,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How big was his empire by then?",
   "scene": "empire1400",
   "date": "c. 1400",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "From the Danube almost to the Euphrates. And for eight years, he kept Constantinople under siege."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So who could stop him?",
   "scene": "timur",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.4,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Timur, the conqueror from Samarkand. His empire stretched from India to the edge of Anatolia."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The two traded insulting letters. Then, in 1400, Timur sacked the Ottoman city of Sivas.",
   "scene": "timurmap",
   "date": "1400",
   "place": "Sivas"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where did they finally meet?",
   "scene": "clash",
   "date": "July 1402",
   "place": "Ankara"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Near Ankara, in July 1402. Timur's army was bigger, and it even had war elephants."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Then, in the middle of the battle, Bayezid's Tatar horsemen and the troops of the Anatolian beys switched sides.",
   "scene": "defect"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did anyone stay loyal?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The Serbs did. Their prince, Stefan Lazarević, son of the Lazar who died at Kosovo, fought to the end.",
   "say": "The Serbs did. Their prince, Stefan Lazarevitch, son of the Lazar who died at Kosovo, fought to the end."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Bayezid fled to the hills, but Timur's men caught him. He is the only Ottoman sultan ever captured in battle.",
   "scene": "zafarnama",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.35,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Is it true Timur kept him in an iron cage?",
   "scene": "cage",
   "move": {
    "from": [
     0.5,
     0.75,
     1.1
    ],
    "to": [
     0.55,
     0.75,
     1.5
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Not exactly. That story comes from later writers. Accounts from the time say he was treated with respect."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Still, he never went home. He died a prisoner in Akşehir, in March 1403.",
   "scene": "captive",
   "date": "March 1403",
   "place": "Akşehir",
   "move": {
    "from": [
     0.75,
     0.5,
     1.0
    ],
    "to": [
     0.8,
     0.55,
     1.25
    ]
   },
   "say": "Still, he never went home. He died a prisoner in Aksheh-heer, in March 1403."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And what happened to his empire?",
   "scene": "lands1403",
   "date": "1403",
   "place": "Ottoman lands"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Timur gave the Anatolian beys back their lands. The Ottomans kept their lands in Europe, but only a corner of Anatolia."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "And Bayezid's sons fought each other for the throne for eleven years."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And Constantinople?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "It was saved, for another fifty years. Next time: the walls of Constantinople. Like the video and follow History Sketches.",
   "scene": "bayezid",
   "date": "",
