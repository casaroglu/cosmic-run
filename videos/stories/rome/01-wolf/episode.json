 "beats": [
  {
   "type": "narration",
   "speaker": "a",
   "scene": "rubens",
   "move": {
    "from": [
     0.43,
     0.6,
     1.35
    ],
    "to": [
     0.43,
     0.6,
     1.15
    ]
   },
   "text": "Two abandoned babies, one wolf, and the city that would rule the world."
  },
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Was Rome really founded by twins raised by a wolf?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "That's the story the Romans told. And Rome still celebrates its birthday every year, on the twenty-first of April."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "today",
   "date": "Today",
   "place": "Rome, Italy",
   "text": "So where did it all start?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "On the river Tiber, in the middle of Italy."
  },
  {
   "type": "narration",
   "speaker": "a",
   "scene": "hills",
   "text": "On one hill in particular: the Palatine, right next to where the Colosseum stands today."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "rubens",
   "move": {
    "from": [
     0.45,
     0.6,
     1.0
    ],
    "to": [
     0.42,
     0.62,
     1.35
    ]
   },
   "text": "And the wolf?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Twin baby boys, Romulus and Remus, were left by the Tiber. A she-wolf found them and fed them, and a shepherd raised them."
  },
  {
   "type": "narration",
   "speaker": "a",
   "scene": "legend",
   "text": "When they grew up, they set out to build a city, but they argued over where. Remus was killed, and the city took Romulus's name."
  },
  {
   "type": "narration",
   "speaker": "a",
   "date": "21 April 753 BC",
   "place": "Rome",
   "text": "Romans later dated that day to the twenty-first of April, 753 BC.",
   "say": "Romans later dated that day to the twenty-first of April, seven fifty-three BC."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "village",
   "text": "Is any of it true?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The twins, probably not. But archaeologists found traces of huts on the Palatine from around that time. A small village of shepherds."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "kings",
   "text": "So how did a village become Rome?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "According to the Romans, seven kings ruled it, one after another. The last one, Tarquin the Proud, was so hated that the people threw him out."
  },
  {
   "type": "narration",
   "speaker": "a",
   "scene": "brutus",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.42,
     1.3
    ]
   },
   "date": "509 BC",
   "place": "Rome",
   "text": "In 509 BC, Rome became a republic. No more kings, just two leaders, elected every year.",
   "say": "In five oh-nine BC, Rome became a republic. No more kings, just two leaders, elected every year."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "borders",
   "text": "How big was Rome by then?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Still small. A strip of land along the Tiber, with Etruscan cities to the north and other Latin towns all around."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: how this small republic took over Italy. Like the video and follow History Sketches so you don't miss it.",
   "cta": true
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you'd like to know about Rome!",
   "cta": true
  },
  {
   "type": "narration",
   "speaker": "a",
   "scene": "rubens",
   "move": {
    "from": [
     0.43,
     0.6,
     1.15
    ],
    "to": [
     0.43,
     0.6,
     1.35
    ]
   },
   "text": "And it all began, the Romans said, with two babies and a wolf."
  }
 ],
