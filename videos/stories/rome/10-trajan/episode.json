  {
   "type": "narration",
   "speaker": "a",
   "text": "Trajan, a soldier emperor born in Spain, near today's Seville. He ruled from 98 to 117, and the Senate called him Optimus, the best ruler.",
   "say": "Trajan, a soldier emperor born in Spain, near today's Seville. He ruled from ninety-eight to one seventeen, and the Senate called him Optimus, the best ruler."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "dacia",
   "place": "Dacia, today's Romania",
   "text": "Where did he fight first?",
   "cameo": {
