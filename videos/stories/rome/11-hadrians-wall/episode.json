 "beats": [
  {
   "type": "narration",
   "speaker": "a",
   "scene": "bellscott",
   "move": {
    "from": [
     0.42,
     0.3,
     1.35
    ],
    "to": [
     0.42,
     0.3,
     1.15
    ]
   },
   "text": "Rome ruled from Syria to Spain, but here, it stopped."
  },
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Why did Rome build a wall across Britain?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "scene": "today",
   "place": "Northern England",
   "text": "Hadrian's Wall still crosses northern England, seventy-three miles from Newcastle to the Solway coast. And it isn't the border with Scotland. It lies wholly in England."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "map122",
   "place": "",
   "date": "AD 122",
   "text": "Who built it?",
   "cameo": {
    "key": "hadrian_head",
    "side": "left",
    "y": 0.62,
    "w": 200,
    "hold": 5,
    "delay": 0.3,
    "caption": "Hadrian"
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Emperor Hadrian, Trajan's successor. He came to Britain in AD 122, and his soldiers began a stone wall from sea to sea.",
   "say": "Emperor Hadrian, Trajan's successor. He came to Britain in A D one twenty-two, and his soldiers began a stone wall from sea to sea."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "bellscott",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.6,
     1.0
    ],
    "to": [
     0.4,
     0.65,
     1.3
    ]
   },
   "text": "Why a wall, and not more conquests?",
   "cameo": {
    "key": "trajan_head",
    "side": "right",
    "y": 0.36,
    "w": 190,
    "hold": 2,
    "caption": "Trajan"
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Trajan's conquests had cost too much. Hadrian wanted borders he could hold. An old biography says the wall was to separate the Romans from the barbarians.",
   "cameo": {
    "key": "aureus",
    "style": "coin",
    "side": "right",
    "y": 0.36,
    "w": 210,
    "hold": 3,
    "delay": 2.0,
    "caption": "Hadrian's gold"
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "gate",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.55,
     1.2
    ]
   },
   "text": "Was it just to keep people out?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Not only. It had a small fort with a gate every Roman mile, so soldiers could watch who crossed, and probably tax the goods they carried."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "wallcard",
   "text": "How big was it?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Three legions built most of it in about six years: eighty milecastles, two turrets between each, and sixteen forts."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "walltown",
   "move": {
    "from": [
     0.5,
     0.6,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.2
    ]
   },
   "text": "Who lived on the wall?",
   "cameo": {
    "key": "legionary",
    "style": "cutout",
    "side": "left",
    "y": 0.5,
    "w": 230,
    "bleed": 20,
    "hold": 3,
    "delay": 0.5
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Soldiers from all over the empire, many from today's Netherlands and Belgium. At Vindolanda fort, just behind it, their letters survived on thin wooden tablets."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "One is a birthday party invitation from around AD 100, perhaps the oldest Latin we have written by a woman.",
   "say": "One is a birthday party invitation from around A D one hundred, perhaps the oldest Latin we have written by a woman."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "map_end",
   "text": "Did the wall work?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "For a while. In 142, Rome pushed north and built a second wall in Scotland, the Antonine Wall. But twenty years later, they came back to Hadrian's.",
   "say": "For a while. In one forty-two, Rome pushed north and built a second wall in Scotland, the Antonine Wall. But twenty years later, they came back to Hadrian's."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Rome held it until it left Britain, around 410.",
   "say": "Rome held it until it left Britain, around four-ten."
  },
  {
   "type": "narration",
   "speaker": "q",
   "scene": "wall2",
   "move": {
    "from": [
     0.5,
     0.6,
     1.0
    ],
    "to": [
     0.5,
     0.4,
     1.2
    ]
   },
   "text": "What's left of it today?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Long stretches of stone, a World Heritage Site since 1987. You can walk the whole line in about a week."
  },
  {
   "type": "narration",
   "speaker": "a",
   "cta": true,
   "text": "Like the video and follow History Sketches for the next episode: the Crisis of the Third Century."
  },
  {
   "type": "narration",
   "speaker": "q",
   "cta": true,
   "text": "And tell us in the comments: would you walk the whole wall?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "scene": "bellscott",
   "move": {
    "from": [
     0.42,
     0.45,
     1.0
    ],
    "to": [
     0.42,
     0.3,
     1.32
    ]
   },
   "text": "Nineteen centuries later, its stones still mark the edge of an empire."
  }
 ],
