{
 "duration": 35.267,
 "lines": [
  {
   "id": "l1",
   "speaker": "a",
   "text": "He set fire to his own pearls.",
   "start": 0.35,
   "end": 2.245
  },
  {
   "id": "l2",
   "speaker": "a",
   "text": "Japan, the 1930s. Kokichi Mikimoto had built his life on cultured pearls.",
   "start": 2.505,
   "end": 9.286
  },
  {
   "id": "l3",
   "speaker": "a",
   "text": "Now cheap, badly farmed pearls were flooding the market, and prices were falling.",
   "start": 9.546,
   "end": 14.737
  },
  {
   "id": "l4",
   "speaker": "a",
   "text": "Buyers began to think every cultured pearl was junk.",
   "start": 14.997,
   "end": 18.354
  },
  {
   "id": "l5",
   "speaker": "a",
   "text": "So in Kobe, in front of the Chamber of Commerce, he lit a fire.",
   "start": 18.614,
   "end": 22.54
  },
  {
   "id": "l6",
   "speaker": "a",
   "text": "And he shovelled in his own low-grade pearls, while the pearl dealers watched.",
   "start": 22.8,
   "end": 27.385
  },
  {
   "id": "l7",
   "speaker": "a",
   "text": "Only the best would carry his name.",
   "start": 27.645,
   "end": 29.528
  },
  {
   "id": "l8",
   "speaker": "a",
   "text": "Burn what cheapens you.",
   "start": 29.788,
   "end": 31.117
  },
  {
   "id": "l9",
   "speaker": "a",
   "text": "Would you burn your own stock, to save your name?",
   "start": 31.377,
   "end": 34.067
  }
 ],
