{
 "duration": 36.646,
 "lines": [
  {
   "id": "l1",
   "speaker": "a",
   "text": "Day one hundred. He still doesn't feel like going. He goes anyway.",
   "start": 0.35,
   "end": 4.69
  },
  {
   "id": "l2",
   "speaker": "a",
   "text": "Day one.",
   "start": 4.95,
   "end": 5.721
  },
  {
   "id": "l3",
   "speaker": "x",
   "text": "I'm tired. I'll start on Monday.",
   "start": 5.981,
   "end": 8.806
  },
  {
   "id": "l4",
   "speaker": "a",
   "text": "That voice never leaves. Not on day one. Not on day one hundred.",
   "start": 9.066,
   "end": 13.35
  },
  {
   "id": "l5",
   "speaker": "x",
   "text": "Just skip today. One day won't matter.",
   "start": 13.61,
   "end": 17.208
  },
  {
   "id": "l6",
   "speaker": "a",
   "text": "One day doesn't. But the choice you practise every day does.",
   "start": 17.468,
   "end": 21.459
  },
  {
   "id": "l7",
   "speaker": "a",
   "text": "So he made one rule. Shoes on. Out the door. Five minutes. Then he's allowed to quit.",
   "start": 21.719,
   "end": 27.422
  },
  {
   "id": "l8",
   "speaker": "a",
   "text": "He almost never quits.",
   "start": 27.682,
   "end": 29.297
  },
  {
   "id": "l9",
   "speaker": "a",
   "text": "Because feelings follow action. Not the other way round.",
   "start": 29.557,
   "end": 32.953
  },
  {
   "id": "l10",
   "speaker": "x",
   "text": "I'm tired.",
   "start": 33.213,
   "end": 34.197
  },
  {
   "id": "l11",
   "speaker": "a",
   "text": "Go anyway.",
   "start": 34.457,
   "end": 35.446
  }
 ],
