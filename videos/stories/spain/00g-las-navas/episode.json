 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Which single day decided the future of Spain?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Many historians would say the sixteenth of July 1212, at Las Navas de Tolosa."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who held Spain before that?",
   "scene": "start",
   "date": "1195",
   "place": "Iberia"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The north was Christian: Castile, Aragon, Navarre and Portugal. The south belonged to the Almohads, rulers of Morocco and al-Andalus."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1195, the Almohads crushed King Alfonso the Eighth of Castile at Alarcos.",
   "scene": "alfonso",
   "date": "1195",
   "place": "Alarcos",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And he wanted revenge?",
   "scene": "print",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He spent seventeen years preparing it. The Pope proclaimed a crusade."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Castile, Aragon and Navarre marched south together. Legend says a shepherd showed them a hidden path through the mountains.",
   "scene": "march",
   "date": "July 1212",
   "place": "Sierra Morena"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "What happened on the day?",
   "scene": "battle3",
   "date": "16 July 1212",
   "place": "Las Navas de Tolosa",
   "move": {
    "from": [
     0.35,
     0.5,
     1.0
    ],
    "to": [
     0.6,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The three kings charged the Almohad camp. The caliph's army broke, and the caliph fled."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A silk banner kept in a monastery in Burgos is said to have been taken that day.",
   "scene": "banner",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And after that?",
   "scene": "end",
   "date": "1250",
   "place": "Iberia"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Within forty years, Córdoba and Seville were Christian. Only Granada was left, for two more centuries.",
   "say": "Within forty years, Cordoba and Seville were Christian. Only Granada was left, for two more centuries."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: 1492, a surrender and a promise. Like the video and follow History Sketches.",
   "scene": "battle",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
