 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "How did Spain become Muslim in just a few years?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "It started in 711, when a king vanished in battle. Spain changed for almost eight centuries."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who ruled Spain before that?",
   "scene": "start",
   "date": "c. 700",
   "place": "Iberia"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The Visigoths: Germanic kings ruling from Toledo. Their lands even reached into southern France."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "They wore jewelled crowns, but their nobles were at each other's throats.",
   "scene": "crowns",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So what happened in 711?",
   "scene": "roderic3",
   "date": "711",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Legend blames a wronged daughter. Her father, Count Julian, took revenge on King Roderic and opened the door to Africa."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In April 711, a Berber commander, Tariq ibn Ziyad, crossed the strait with a small army.",
   "scene": "crossing",
   "date": "April 711",
   "place": "Strait of Gibraltar",
   "say": "In April 711, a Berber commander, Tariq ibn Ziyad, crossed the strait with a small army."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The rock where he landed still carries his name: Jabal Tariq. Gibraltar."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And King Roderic?",
   "scene": "roderic2",
   "date": "711",
   "place": "Guadalete",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.6,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He rushed south. At the river Guadalete, his army was routed. The king died, and his body was never found."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How fast did the rest fall?",
   "scene": "tariq",
   "date": "711 – 718",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Within a few years, almost the whole peninsula was under Muslim rule. It became al-Andalus."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Almost?",
   "scene": "end",
   "date": "c. 720",
   "place": "al-Andalus"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Right. A few mountain valleys in the far north never fell. Muslim rule elsewhere would last, in shrinking form, until 1492."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: Covadonga, the battle in the mountains. Like the video and follow History Sketches.",
   "scene": "roderic4",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: Covadonga, the battle in the mountains",
   "sub": "Follow History Sketches"
  }
 ],
