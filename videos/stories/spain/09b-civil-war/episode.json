 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "How did Spain's civil war become the world's war?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Because foreign powers sent planes, tanks and volunteers. Spain became a rehearsal for the Second World War."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where were the front lines?",
   "scene": "start",
   "date": "November 1936",
   "place": "Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "By November 1936, Franco's army held the west and reached Madrid. The city held."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Its slogan went around the world: they shall not pass.",
   "scene": "feixisme",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.45,
     1.0
    ],
    "to": [
     0.5,
     0.4,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who helped whom?",
   "scene": "world"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Hitler and Mussolini sent Franco planes, tanks and troops. Stalin sent the Republic weapons."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "And volunteers from dozens of countries came to fight for the Republic: the International Brigades.",
   "scene": "brigade",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "What was Guernica?",
   "scene": "guernica",
   "date": "26 April 1937",
   "place": "Guernica",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "On a busy Monday, German and Italian bombers destroyed the Basque town of Guernica. Picasso painted it, and the world saw it."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Behind both front lines, tens of thousands of civilians were killed for who they were, or what they believed."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did the Republic ever strike back?",
   "scene": "ebro",
   "date": "July 1938",
   "place": "Ebro",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1938, it gambled on one last offensive at the Ebro. It lasted four months, and failed."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Catalonia fell. Hundreds of thousands fled across the snow into France, and ended up in camps on the beach.",
   "scene": "argeles",
   "date": "February 1939",
   "place": "Argelès-sur-Mer",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And the end?",
   "scene": "end",
   "date": "1 April 1939",
   "place": "Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "On the first of April 1939, Franco announced: the war is over. He would rule Spain for thirty-six years."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: how a dictator's heir gave Spain democracy. Like the video and follow History Sketches.",
   "scene": "parade",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: how a dictator's heir gave Spain democracy",
