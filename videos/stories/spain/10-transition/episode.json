 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "How did a dictator's chosen heir give Spain democracy?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "By doing the opposite of what the dictator expected. His name was Juan Carlos."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "What was Spain like under Franco?",
   "scene": "start",
   "date": "1939",
   "place": "Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "After 1939, Franco ruled alone: prisons, censorship, hunger. Europe shut Spain out."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The Cold War rescued him. In 1953, American bases came to Spain, and later American presidents came to Madrid.",
   "scene": "nixon",
   "date": "1953",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In the sixties, tourists and factories made Spain boom. But there were still no free elections.",
   "scene": "parade",
   "date": "1960s",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who was supposed to come next?",
   "scene": "heir",
   "date": "22 July 1969",
   "move": {
    "from": [
     0.5,
     0.45,
     1.0
    ],
    "to": [
     0.5,
     0.4,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1969 Franco named his heir: young Prince Juan Carlos. Everyone expected more of the same."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1973, an ETA bomb killed Franco's prime minister. It threw his car over a five-storey building.",
   "scene": "carrero",
   "date": "20 December 1973",
   "place": "Madrid",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And when Franco died?",
   "scene": "king",
   "date": "22 November 1975",
   "move": {
    "from": [
     0.5,
     0.45,
     1.0
    ],
    "to": [
     0.5,
     0.4,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He died in November 1975. Two days later, Juan Carlos became king."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He picked Adolfo Suárez, a man of the old regime, to take it apart. In 1977, Spain voted freely for the first time in forty-one years.",
   "scene": "suarez",
   "date": "15 June 1977",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   },
   "say": "He picked Adolfo Suarez, a man of the old regime, to take it apart. In 1977, Spain voted freely for the first time in forty-one years."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A year later, Spaniards approved a democratic constitution.",
   "scene": "votes",
   "date": "6 December 1978"
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did everyone accept it?",
   "scene": "cortes",
   "date": "23 February 1981",
   "place": "Madrid",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Not everyone. In 1981, a Civil Guard colonel stormed parliament with armed men and held the deputies hostage."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "That night the king, in uniform, went on TV and ordered the army to stand by democracy. By the next day, the coup had collapsed.",
   "scene": "jc",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And Spain after that?",
   "scene": "end",
   "date": "1986",
   "place": "Europe"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A democracy, and in 1986 a member of the European Community. The heir the dictator chose had saved the democracy."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "That's the story of Spain. Like the video and follow History Sketches."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Which episode was your favourite? Tell us in the comments!"
  },
  {
   "type": "end",
   "text": "Thanks for watching!",
   "sub": "Like · Follow · Comment"
  }
 ],
