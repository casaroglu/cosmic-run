 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Was Spain's most famous battle really just a skirmish?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "It might have been. It happened at Covadonga, high in the mountains of Asturias."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where is that?",
   "scene": "today",
   "date": "Today",
   "place": "Asturias, Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In the Picos de Europa, in northern Spain. Today it's a shrine visited by thousands every year."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who fought there?",
   "scene": "start",
   "date": "c. 722",
   "place": "Asturias"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "After 711, only the wild mountains of the north stayed out of Muslim hands. There, a nobleman named Pelayo led a revolt."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A Muslim force marched into the narrow valley at Covadonga to crush him. It was ambushed and beaten.",
