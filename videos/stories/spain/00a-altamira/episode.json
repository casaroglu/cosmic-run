 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Why did experts call a little girl's discovery a fake?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Because the paintings looked too good to be real. This is Altamira, in northern Spain."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where exactly is it?",
   "scene": "today",
   "date": "Today",
   "place": "Cantabria, Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Near the village of Santillana del Mar, in Cantabria, not far from the Bay of Biscay."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And how was it found?",
   "scene": "sautuola",
   "date": "1879",
   "place": "Altamira",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 1879, an amateur scientist, Marcelino Sanz de Sautuola, was digging in the cave near his home."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His little daughter María wandered deeper inside, looked up, and shouted: Papa, bulls!",
   "scene": "maria",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "The ceiling was covered in bison, in red, black and ochre, painted over the bumps of the rock so they seem to breathe.",
   "scene": "bison2",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So he became famous?",
   "scene": "drawing",
   "date": "1880",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Not exactly. He published his find in 1880, and Europe's experts laughed. Far too good for cavemen, they said. A forgery."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Sautuola died in 1888, still called a fraud."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did anyone ever say sorry?",
   "scene": "cartailhac",
   "date": "1902",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Yes. In 1902, the leading sceptic, Émile Cartailhac, published an apology. Its title: Mea culpa of a sceptic.",
   "say": "Yes. In 1902, the leading sceptic, Emile Cartaiyak, published an apology. Its title: Mea culpa of a sceptic."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So how old are the paintings?",
   "scene": "age",
   "date": ""
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Some marks in Altamira are over thirty-five thousand years old."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Can anyone visit the cave?",
   "scene": "ceiling",
   "date": "Today",
   "place": "Altamira",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Only five people a week may enter, chosen by lottery. Everyone else visits an exact replica next door."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: the Spanish city older than Rome. Like the video and follow History Sketches.",
   "scene": "bison",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: the Spanish city older than Rome",
   "sub": "Follow History Sketches"
  }
 ],
