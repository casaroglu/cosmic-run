 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Why did the most powerful man on Earth give it all up?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Because the wars never ended, and neither did the debts. Charles the Fifth quit, and wept in front of his court."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How big was his empire?",
   "scene": "start",
   "date": "1550",
   "place": "Europe"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Spain, the Netherlands, much of Italy, Austria, and the Holy Roman Empire. And across the ocean, the Americas."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Under his crown, Cortés destroyed the Aztec empire, and Pizarro the Inca. American silver began to pour into Spain.",
   "scene": "tenochtitlan",
   "date": "1521 – 1533",
   "place": "The Americas",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who were his enemies?",
   "scene": "pavia",
   "date": "24 February 1525",
   "place": "Pavia",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "France above all. On his twenty-fifth birthday, his army crushed the French at Pavia, and captured their king."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Francis the First was held in Madrid for a year. He signed a peace treaty, and broke it as soon as he was free.",
   "scene": "francis",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.35,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Then Charles's own unpaid soldiers mutinied, and sacked Rome. The Pope hid in a fortress.",
   "scene": "sack",
   "date": "6 May 1527",
   "place": "Rome",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did he ever win?",
   "scene": "muhlberg2",
   "date": "24 April 1547",
   "place": "Mühlberg",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Yes. He beat the Protestant princes at Mühlberg. Titian painted him as the perfect Christian knight.",
   "say": "Yes. He beat the Protestant princes at Muhlberg. Titian painted him as the perfect Christian knight."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So why did he quit?",
   "scene": "abdication",
   "date": "25 October 1555",
   "place": "Brussels",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Worn out by wars and debts, he gave up his crowns, and wept in front of his court."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who got the empire?",
   "scene": "end",
   "date": "1556",
   "place": "Europe"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "It was split. His brother Ferdinand took Austria and the imperial crown. His son Philip took Spain, the Netherlands, Italy and the Americas."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Charles retired to a small house beside a monastery in Spain, at Yuste, and died there in 1558.",
   "scene": "yuste",
   "date": "21 September 1558",
   "place": "Yuste",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: Philip the Second, the king who ruled from a desk. Like the video and follow History Sketches.",
   "scene": "seated",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.35,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: Philip the Second, the king who ruled from a desk",
   "sub": "Follow History Sketches"
  }
