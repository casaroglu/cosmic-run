 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Who inherited half the world at sixteen?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Charles of Habsburg. He became king of Spain, and he could barely speak Spanish."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Where was he from?",
   "scene": "young",
   "date": "24 February 1500",
   "place": "Ghent",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He was born in Ghent, in today's Belgium, in 1500: grandson of Isabella and Ferdinand of Spain, and of the Holy Roman Emperor."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How did he get so much?",
   "scene": "start",
   "date": "1516",
   "place": "Europe"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "One by one, the heirs ahead of him died. He inherited Spain, the Netherlands, southern Italy, and the new lands across the ocean."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His mother, Queen Joanna, was declared unfit to rule, and kept shut away for forty-six years.",
   "scene": "juana",
   "date": "1516",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "So at sixteen, Charles became king of Spain.",
   "scene": "young2",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And then he became emperor?",
   "scene": "end",
   "date": "28 June 1519",
   "place": "Europe"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Right. Three years later, with loans from the Fugger bankers, he bought the votes that made him Holy Roman Emperor. That added Austria and the German lands."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His motto was Plus Ultra, further beyond, around the Pillars of Hercules. It is still on Spain's flag today.",
   "scene": "hercules",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Did Spain love its new king?",
   "scene": "comuneros",
   "date": "1520 – 1521",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Not exactly. Castile hated its foreign king. The cities rose up. At Villalar the rebels were crushed, and their leaders beheaded."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "That same month in Germany, a monk named Martin Luther stood before him, and refused to take back a single word.",
   "scene": "worms",
   "date": "April 1521",
   "place": "Worms",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "And across the ocean, a few hundred Spaniards were about to bring down an empire.",
   "scene": "tenochtitlan",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: the emperor who gave it all up. Like the video and follow History Sketches.",
   "scene": "young3",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.35,
     1.2
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: the emperor who gave it all up",
   "sub": "Follow History Sketches"
  }
 ],
 "clips": {
