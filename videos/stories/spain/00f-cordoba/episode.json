 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "Which city was the most dazzling in Europe a thousand years ago?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Many would say Córdoba, in southern Spain, the capital of al-Andalus.",
   "say": "Many would say Cordoba, in southern Spain, the capital of al-Andalus."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "What was it famous for?",
   "scene": "roberts",
   "date": "780s",
   "place": "Córdoba",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In the 780s, a prince who had escaped the massacre of his family in Syria began a great mosque there."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His heirs kept enlarging it: a forest of more than eight hundred columns under red and white arches.",
   "scene": "arches",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How big was al-Andalus at its height?",
   "scene": "start",
   "date": "929",
   "place": "al-Andalus"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In 929, it covered most of the peninsula. Only the Christian kingdoms of the north lay beyond its borders."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "That year, Abd al-Rahman the Third declared himself caliph, defying Baghdad. Envoys came from Byzantium and the German emperor.",
   "scene": "baixeras",
   "date": "929",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Outside the city he built a whole palace town: Medina Azahara.",
   "scene": "azahara",
   "date": "936",
   "place": "Medina Azahara",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And the famous library?",
   "scene": "mihrab",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "His son's library was said to hold four hundred thousand books. Historians doubt the number, but not the fame."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So what went wrong?",
   "scene": "end",
   "date": "1031",
   "place": "al-Andalus"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Civil war. In 1031 the caliphate shattered into rival little kingdoms, the taifas."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Christian Castile took Córdoba in 1236. Three centuries later, a cathedral was built right in the middle of the mosque.",
   "scene": "photo1855",
   "date": "1236",
   "place": "Córdoba",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   },
   "say": "Christian Castile took Cordoba in 1236. Three centuries later, a cathedral was built right in the middle of the mosque."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "So is it a mosque or a cathedral?",
   "scene": "arches2",
   "date": "Today",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Córdoba still argues about what to call it.",
   "say": "Cordoba still argues about what to call it."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: 1212, Las Navas de Tolosa. Like the video and follow History Sketches."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: 1212, Las Navas de Tolosa",
   "sub": "Follow History Sketches"
  }
