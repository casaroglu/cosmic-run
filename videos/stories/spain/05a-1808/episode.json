 "beats": [
  {
   "type": "title",
   "speaker": "q",
   "scene": "globe",
   "text": "How did Napoleon take Spain's crown without a battle?"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "With a trap. In 1808, Spain had two kings, and Napoleon took the crown from both."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "Who ruled Spain then?",
   "scene": "family",
   "date": "1808",
   "place": "Madrid",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "A weak king, Charles the Fourth. And a hated favourite who really ran the country: Manuel Godoy."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How did the French get in?",
   "scene": "start",
   "date": "1807",
   "place": "Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Godoy let French troops march through Spain to attack Portugal. Soon they were everywhere."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "In March 1808, a mob stormed Godoy's palace. Two days later, the king gave up the crown to his own son, Ferdinand.",
   "scene": "aranjuez",
   "date": "17 March 1808",
   "place": "Aranjuez",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.5,
     0.45,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And Napoleon?",
   "scene": "napoleon",
   "date": "April 1808",
   "place": "Bayonne",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.3
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He invited father and son to Bayonne, in France, to settle their quarrel. It was a trap."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "How did Madrid react?",
   "scene": "dosmayo",
   "date": "2 May 1808",
   "place": "Madrid",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "When the French moved to take away the last of the royal family, the crowd exploded. Knives and stones against cavalry."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "That night, the French shot the prisoners they had taken.",
   "scene": "tresmayo",
   "date": "3 May 1808",
   "move": {
    "from": [
     0.5,
     0.5,
     1.0
    ],
    "to": [
     0.55,
     0.5,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Goya painted it six years later. A man in a white shirt, arms wide open, facing the guns.",
   "scene": "shirt",
   "move": {
    "from": [
     0.4,
     0.5,
     1.0
    ],
    "to": [
     0.42,
     0.48,
     1.6
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And the crown?",
   "scene": "end",
   "date": "May 1808",
   "place": "Spain"
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Days later in Bayonne, both kings signed it away. Napoleon gave Spain to his brother, Joseph."
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "He thought Spain was finished. Instead, the whole country rose.",
   "scene": "joseph",
   "date": "",
   "move": {
    "from": [
     0.5,
     0.4,
     1.0
    ],
    "to": [
     0.5,
     0.33,
     1.25
    ]
   }
  },
  {
   "type": "narration",
   "speaker": "a",
   "text": "Next time: the little war that gave English a new word. Like the video and follow History Sketches."
  },
  {
   "type": "narration",
   "speaker": "q",
   "text": "And tell us in the comments what you think!"
  },
  {
   "type": "end",
   "text": "Next: the little war that gave English a new word",
   "sub": "Follow History Sketches"
  }
 ],
 "clips": {
